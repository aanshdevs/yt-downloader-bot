# --- Required ---
BOT_TOKEN=123456:ABC-your-botfather-token
OWNER_ID=123456789

# --- Badi files: kuch set na karo to Gofile.io (no card/signup) use hota hai ---
# GOFILE_TOKEN=                # optional: gofile.io account token, link kabhi expire nahi hoga

# --- Cloudflare R2 (badi files ke liye, optional - Gofile ki jagah use hoga) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Optional ---
# CHANNEL_URL=https://www.youtube.com/@yourchannel/shorts
# DEFAULT_HEIGHT=720        # /latest ke liye
# MAX_DOWNLOAD_MB=3000      # is se bada download nahi hoga
# LINK_HOURS=24             # R2 link kitne ghante valid (max 168)
# YT_COOKIES_B64=           # bot-check aaye tab
# JS_RUNTIME=node           # sirf Termux pe
